{
    "name": "@jstmemit/shared",
    "private": true,
    "type": "module",
    "devDependencies": {
        "@jstmemit/meme-generator": "workspace:*",
        "react": "^19.2.7",
        "satori": "^0.26.0"
    },
    "imports": {
        "#/*": [
            "./src/*"
        ]
    },
    "exports": {
        "./*.ts": "./src/*.ts",
        "./*.tsx": "./src/*.tsx",
        "./*": [
            "./src/*.ts",
            "./src/*.tsx"
        ]
    }
}
