{
    "name": "@jstmemit/cache",
    "private": true,
    "type": "module",
    "devDependencies": {
        "@jstmemit/analytics": "workspace:*",
        "@jstmemit/telemetry": "workspace:*",
        "@jstmemit/shared": "workspace:*",
        "@jstmemit/queue": "workspace:*"
    },
    "imports": {
        "#/*": [
            "./src/*"
        ]
    },
    "exports": {
        "./*.ts": "./src/*.ts",
        "./*": [
            "./src/*.ts"
        ]
    },
    "dependencies": {
        "@keyv/redis": "^5.1.6",
        "@opentelemetry/api-logs": "^0.220.0",
        "@opentelemetry/exporter-logs-otlp-http": "^0.220.0",
        "@opentelemetry/resources": "^2.9.0",
        "@opentelemetry/sdk-logs": "^0.220.0",
        "@opentelemetry/sdk-node": "^0.220.0",
        "keyv": "^5.6.0"
    }
}
