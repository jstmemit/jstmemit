---
import type { GetStaticPaths } from "astro";
import type { ITemplatesRepository } from "@jstmemit/shared/interfaces/ITemplatesRepository";
import { TemplatesRepository } from "@jstmemit/shared/repositories/TemplatesRepository";
import type { Template } from "@jstmemit/shared/models/Template";
import TemplateLayout from "../../layouts/TemplateLayout.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export const getStaticPaths = (() => {
    const templatesRepository: ITemplatesRepository = new TemplatesRepository();
    return templatesRepository.getAll().map((template: Template) => ({
        params: { template: template.name },
    }));
}) satisfies GetStaticPaths;

const templatesRepository: ITemplatesRepository = new TemplatesRepository();
const templates: Template[] = templatesRepository.getAll();

const { template } = Astro.params;
const currentTemplate: Template | undefined = templates.find(
    (element: Template): boolean => element.name == template,
);

if (!currentTemplate) {
    throw new Error();
}
---

<BaseLayout>
    <TemplateLayout template={currentTemplate} />
</BaseLayout>
