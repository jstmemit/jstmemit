---
import type { TemplateText } from "@jstmemit/shared/models/TemplateText";
import type { TemplateImage } from "@jstmemit/shared/models/TemplateImage";

interface Props {
    title: string;
    slots?: TemplateText[] | TemplateImage[];
}

const { title, slots = [] } = Astro.props;
---

{
    slots.length > 0 && (
        <section>
            <h2 class="mb-3 text-3xl font-bold">{title}</h2>
            <ul class="flex flex-col gap-1">
                {slots.map((slot: TemplateText | TemplateImage, index: number) => (
                    <li>
                        <h3 class=`border-l-2 border-hot-fuchsia pl-3 tabular-nums`>
                            <b>#{slot.id}: </b> {slot.description}
                        </h3>
                    </li>
                ))}
            </ul>
        </section>
    )
}
