---
import MemeGrid from "./MemeGrid.astro";
import type { Template } from "@jstmemit/shared/models/Template";
import MemeCard from "./MemeCard.astro";
import type { TemplateProps } from "@jstmemit/shared/models/TemplateProps";

interface Props {
    template: Template;
    variants: TemplateProps[];
    heading?: string;
    link?: string;
    cols?: number;
    gap?: string;
}

const { template, variants, cols = 3, heading = "Meme examples", link } = Astro.props;
---

<section>
    {
        link ? (
            <a href={link}>
                <h2 class="mb-3 text-3xl font-bold">{heading}</h2>
            </a>
        ) : (
            <h2 class="mb-3 text-3xl font-bold">{heading}</h2>
        )
    }

    <MemeGrid cols={cols} variants={variants} templateName={template.name} gap="gap-1" server:defer />
</section>
