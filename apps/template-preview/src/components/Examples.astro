---
import MemeGrid from "./MemeGrid.astro";
import type { Template } from "@jstmemit/shared/models/Template";
import MemeCard from "./MemeCard.astro";

interface Props {
    template: Template;
}

const { template, variants } = Astro.props;
---

<section>
    <h2 class="mb-3 text-3xl font-bold">Meme examples</h2>
    <MemeGrid variants={variants} template={template} />
</section>
