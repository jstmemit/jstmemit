---
import type { TemplateProps } from "@jstmemit/shared/models/TemplateProps";
import type { Template } from "@jstmemit/shared/models/Template";
import MemeCard from "./MemeCard.astro";
import { Renderer } from "takumi-js/node";

interface Props {
    template: Template;
    variants: TemplateProps[];
    cols: number;
    gap?: string;
}

const { template, variants, cols, gap = "gap-5" } = Astro.props;
---

<ul class:list={["flex flex-wrap", gap]}>
    {
        variants.map((variant: TemplateProps) => (
            <MemeCard
                variant={variant}
                templateWidth={template.width}
                templateHeight={template.height}
                templateName={template.name}
                size=`1/${cols}`
            />
        ))
    }
</ul>
