---
import type { Template } from "@jstmemit/shared/models/Template";

interface Props {
    src: string;
    template: Template;
    size: "1/3" | "1/4";
}

const { src, template, size = "1/3" } = Astro.props;

const sizes = {
    "1/3": "lg:max-w-[calc((100%-20px)/2)] 2xl:max-w-[calc((100%-20px*2)/3)]",
    "1/4": "lg:max-w-[calc((100%-20px)/3)] 2xl:max-w-[calc((100%-10px*2)/4)]",
};
---

<li class:list={["bg-white/10", sizes[size]]}>
    <img
        src={src}
        width={template.width}
        height={template.height}
        alt={template.name}
        decoding="async"
        fetchpriority="low"
        loading="lazy"
    />
</li>
