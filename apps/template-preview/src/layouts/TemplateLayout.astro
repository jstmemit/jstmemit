---
import Sidebar from "../components/Sidebar.astro";
import type { Template } from "@jstmemit/shared/models/Template";
import type { TemplateText } from "@jstmemit/shared/models/TemplateText";

interface Props {
    template: Template;
}

const { template } = Astro.props;
---

<div class="flex gap-10">
    <Sidebar />
    <section class="flex w-full flex-col gap-7.5">
        <div class="flex flex-col gap-1">
            <h1 class="mb-2 text-4xl font-black">{template.name}</h1>
            <p class="border-l-2 border-white/40 pl-4"><b>Width:</b> {template.width}px</p>
            <p class="border-l-2 border-white/20 pl-4"><b>Height:</b> {template.height}px</p>
        </div>

        {
            template?.texts?.length != 0 && (
                <section>
                    <h2 class="mb-3 text-3xl font-bold">Texts</h2>
                    <ul>
                        {template.texts?.map((text: TemplateText) => (
                            <li>
                                <h3 class="mt-2 mb-2 border-l-2 border-white/40 pl-3 text-xl font-bold first-letter:capitalize">
                                    {text.description}
                                </h3>
                                <p class="ml-3 border-l-2 border-white/30 pl-4">
                                    <b>Id:</b> {text.id}
                                </p>
                                <p class="ml-3 border-l-2 border-white/20 pl-4">
                                    <b>Minimum length:</b> {text.minLength}
                                </p>
                                <p class="ml-3 border-l-2 border-white/10 pl-4">
                                    <b>Maximum length:</b> {text.maxLength}
                                </p>
                            </li>
                        ))}
                    </ul>
                </section>
            )
        }

        <section>
            <h2 class="mb-3 text-3xl font-bold">Texts</h2>
            <ul>
                {
                    template.texts?.map((text: TemplateText) => (
                        <li>
                            <h3 class="mt-2 mb-2 border-l-2 border-white/40 pl-3 text-xl font-bold first-letter:capitalize">
                                {text.description}
                            </h3>
                            <p class="ml-3 border-l-2 border-white/30 pl-4">
                                <b>Id:</b> {text.id}
                            </p>
                            <p class="ml-3 border-l-2 border-white/20 pl-4">
                                <b>Minimum length:</b> {text.minLength}
                            </p>
                            <p class="ml-3 border-l-2 border-white/10 pl-4">
                                <b>Maximum length:</b> {text.maxLength}
                            </p>
                        </li>
                    ))
                }
            </ul>
        </section>
    </section>
</div>
