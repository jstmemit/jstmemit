---
<section
        class="relative flex h-[80vh] flex-col items-center justify-center gap-5 overflow-hidden bg-black text-white"
>
    <slot name="text" />
    <img
            class="absolute z-2"
            src="https://files.wideunits.nl/jstmemit/images/background/Highlights.png"
            alt="background highlight"
    />
    <img
            class="absolute z-1 opacity-6"
            src="https://files.wideunits.nl/jstmemit/images/background/Noise.png"
            alt="background noise"
    />
    <img class="absolute z-1" src="https://files.wideunits.nl/jstmemit/images/background/Grid.png" alt="grid" />

    <slot name="memes" />

    <img
            class="absolute z-1 opacity-55 brightness-0"
            src="https://files.wideunits.nl/jstmemit/images/background/Fog%20over%20memes.png"
            alt="fog over memes"
    />
    <img
            class="absolute z-1 opacity-55 brightness-0"
            src="https://files.wideunits.nl/jstmemit/images/background/Fog%20over%20blurred%20memes.png"
            alt="fog over memes"
    />
</section>