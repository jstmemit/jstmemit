---
import type { MemeGridItem } from "#/models/MemeGridItem.ts";

interface Props {
    classes?: string;
}

const { classes } = Astro.props;

// TODO: replace with s3 meme links
const tiles: MemeGridItem[] = [
    { span: "col-span-4", height: "h-90", image: "https://files.wideunits.nl/jstmemit/images/templates/bbCooking.jpg", alt: "" },
    { span: "col-span-5", height: "h-90", border: true, image: "https://files.wideunits.nl/jstmemit/images/templates/cowlookingintoocean.png", alt: "" },
    { span: "col-span-5", height: "h-80", image: "https://files.wideunits.nl/jstmemit/images/templates/buzz.png", alt: "" },
    { span: "col-span-4", height: "h-80", border: true, image: "https://files.wideunits.nl/jstmemit/images/templates/iSteppedInShit.jpg", alt: "" },
    { span: "col-span-3", height: "h-60", border: true, image: "https://files.wideunits.nl/jstmemit/images/templates/homerhiding.jpg", alt: "" },
    { span: "col-span-6", height: "h-60", image: "https://files.wideunits.nl/jstmemit/images/templates/futuramaNotSureIfFry.jpg", alt: "" },
    { span: "col-span-4", height: "h-90", image: "https://files.wideunits.nl/jstmemit/images/templates/grokTweet.jpg", alt: "" },
    { span: "col-span-5", height: "h-90", border: true, image: "https://files.wideunits.nl/jstmemit/images/templates/isthisapigeon.png", alt: "" },
];
---

<ul
    class=`bg-void-black absolute -top-40 -right-14 hidden w-full max-w-[42vw] rotate-8 grid-cols-9 gap-6 rounded-4xl p-4 xl:grid 2xl:max-w-180 ${classes} shadow-[0_10px_0_0_rgba(0,0,0,0.25)]`
>
    {
        tiles.map((meme: MemeGridItem) => (
            <img
                src={meme.image}
                alt={meme.alt}
                class=`bg-carbon-black ${meme.span} ${meme.height} w-full rounded-2xl ${meme.border ? "border-bubblegum-pink" : "border-carbon-black"} border-4 shadow-[0_10px_0_0_rgba(0,0,0,0.25)]`
            />
        ))
    }
</ul>