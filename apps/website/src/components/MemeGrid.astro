---
import type { MemeGridItem } from "#/models/MemeGridItem.ts";
import { Swiper, SwiperWrapper, SwiperSlide, SwiperPagination } from "astro-swiper";
import Card from "#/components/ui/Card.astro";
import Heading from "#/components/ui/Heading.astro";
import Paragraph from "#/components/ui/Paragraph.astro";

interface Props {
    classes?: string;
}

const { classes } = Astro.props;

const tiles: MemeGridItem[] = [
    { span: "col-span-4", color: "bg-dark-cyan", height: "h-90", image: "https://jstmemit.com/cdn-cgi/image/format=avif,fit=scale-down,metadata=none,sharpen=1,onerror=redirect,quality=40,slow-connection-quality=22,width=768/https://files.jstmemit.com/jstmemit/images/templates/bbCooking.jpg", alt: "" },
    { span: "col-span-5", height: "h-90", border: true, image: "https://jstmemit.com/cdn-cgi/image/format=avif,fit=scale-down,metadata=none,sharpen=1,onerror=redirect,quality=40,slow-connection-quality=22,width=768/https://files.jstmemit.com/jstmemit/images/templates/cowlookingintoocean.png", alt: "" },
    { span: "col-span-5", color: "bg-dark-cyan", height: "h-80", image: "https://jstmemit.com/cdn-cgi/image/format=avif,fit=scale-down,metadata=none,sharpen=1,onerror=redirect,quality=40,slow-connection-quality=22,width=768/https://files.jstmemit.com/jstmemit/images/templates/buzz.png", alt: "" },
    { span: "col-span-4", height: "h-80", border: true, image: "https://jstmemit.com/cdn-cgi/image/format=avif,fit=scale-down,metadata=none,sharpen=1,onerror=redirect,quality=40,slow-connection-quality=22,width=768/https://files.jstmemit.com/jstmemit/images/templates/iSteppedInShit.jpg", alt: "" },
    { span: "col-span-3", height: "h-60", border: true, image: "https://jstmemit.com/cdn-cgi/image/format=avif,fit=scale-down,metadata=none,sharpen=1,onerror=redirect,quality=40,slow-connection-quality=22,width=768/https://files.jstmemit.com/jstmemit/images/templates/homerhiding.jpg", alt: "" },
    { span: "col-span-6", color: "bg-dark-cyan", height: "h-60", image: "https://jstmemit.com/cdn-cgi/image/format=avif,fit=scale-down,metadata=none,sharpen=1,onerror=redirect,quality=40,slow-connection-quality=22,width=768/https://files.jstmemit.com/jstmemit/images/templates/futuramaNotSureIfFry.jpg", alt: "" },
    { span: "col-span-4", color: "bg-dark-cyan", height: "h-90", image: "https://jstmemit.com/cdn-cgi/image/format=avif,fit=scale-down,metadata=none,sharpen=1,onerror=redirect,quality=40,slow-connection-quality=22,width=768/https://files.jstmemit.com/jstmemit/images/templates/grokTweet.jpg", alt: "" },
    { span: "col-span-5", height: "h-90", border: true, image: "https://jstmemit.com/cdn-cgi/image/format=avif,fit=scale-down,metadata=none,sharpen=1,onerror=redirect,quality=40,slow-connection-quality=22,width=768/https://files.jstmemit.com/jstmemit/images/templates/isthisapigeon.png", alt: "" },
];
---

<section aria-labelledby="thisIsWhatYouGetHeading" aria-describedby="thisIsWhatYouGetDescription" class="xl:hidden">
    <div class="px-8 pt-8 flex flex-col gap-3">
        <Heading id="thisIsWhatYouGetHeading">
            This is what you <em class="text-bubblegum-pink not-italic">get</em>
        </Heading>
        <Paragraph id="thisIsWhatYouGetDescription">
            Don't forget that your memes will be made from your own chats, images and inside jokes. This makes them relatable and funnier than these examples.
        </Paragraph>
    </div>
    <Swiper
        options={{
            loop: true,
            effect: "creative",
            grabCursor: true,
            pagination: {
                el: ".swiper-pagination",
            },
            autoplay: {
                delay: 1500,
                disableOnInteraction: true,
            },
            creativeEffect: {
                prev: {
                    shadow: true,
                    translate: ["-125%", 0, -800],
                    rotate: [0, 0, -90],
                },
                next: {
                    shadow: true,
                    translate: ["125%", 0, -800],
                    rotate: [0, 0, 90],
                },
            },
        }}
    >
        <SwiperWrapper
        class="pt-6 py-12 scale-90"
        >
            {
                tiles.map((meme: MemeGridItem) => (
                    <SwiperSlide>
                        <Card
                            label={meme.image.split("/").pop() || "meme.png"}
                            color={meme.color}
                            classes="h-80 sm:h-160 w-full object-cover mt-7"
                            border=`${meme.border ? "border-bubblegum-pink" : "border-dark-cyan"} border-4`
                        >
                            <img
                                src={meme.image}
                                alt={meme.alt}
                                fetchpriority="low"
                                loading="lazy"
                                class=`bg-carbon-black rounded-t-none rounded-xl w-full h-full object-cover`
                            />
                        </Card>
                    </SwiperSlide>
                ))
            }
            <SwiperPagination />
        </SwiperWrapper>
    </Swiper>
</section>


<ul
    aria-label="Grid of meme examples"
    class:list={["bg-carbon-black absolute -top-40 -right-20 hidden w-full max-w-[42vw] rotate-8 grid-cols-9 gap-6 gap-y-12 rounded-4xl p-4 xl:grid 2xl:max-w-180", classes]}
>
    {
        tiles.map((meme: MemeGridItem) => (
            <Card
                label={meme.image.split("/").pop() || "meme.png"}
                color={meme.color}
                classes=`${meme.span} ${meme.height}`
                border=`${meme.border ? "border-bubblegum-pink" : "border-dark-cyan"} border-4`
            >
                <img
                    src={meme.image}
                    alt={meme.alt}
                    fetchpriority="low"
                    loading="lazy"
                    class:list={["bg-carbon-black w-full rounded-t-none rounded-xl h-full", meme.span, meme.height]}
                />
            </Card>

        ))
    }
</ul>