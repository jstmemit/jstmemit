---
import Section from "#/components/ui/Section.astro";
import Heading from "#/components/ui/Heading.astro";
import Paragraph from "#/components/ui/Paragraph.astro";
import Content from "#/components/ui/Content.astro";
import Highlight from "#/components/ui/Highlight.astro";
import FaqItem from "#/components/ui/FaqItem.astro";
import FaqGrid from "#/components/ui/FaqGrid.astro";
import { questions } from "#/data/questions.ts";
import type { FaqQuestion } from "#/models/FaqQuestion.ts";
import { getFaqJsonLd } from "#/helpers/jsonLd/getFaqJsonLd.ts";
---

<Section variant="dark" headingId="faqHeading" descriptionId="faqDescription">
    <Content slot="text">
        <script is:inline type="application/ld+json" set:html={JSON.stringify(getFaqJsonLd(questions))} />

        <Heading id="faqHeading"> Frequently asked questions </Heading>
        <Paragraph id="faqDescription"
            >Can't find your answer? We can help you in the <a
                href="https://discord.gg/THRnn8fhkZ"
                target="_blank"
                class="text-bubblegum-pink"
                rel="noopener noreferrer">Support server</a
            >
        </Paragraph>
        <FaqGrid>
            {
                questions.map((question: FaqQuestion) => (
                    <FaqItem headingId={`${question.id}Heading`} descriptionId={`${question.id}Description`}>
                        <Heading variant="h3" id={`${question.id}Heading`}>
                            {question.question}
                        </Heading>
                        <Paragraph classes="text-base font-medium" id={`${question.id}Description`}>
                            <Highlight color="text-bubblegum-pink font-bold">{question.highlight}</Highlight>{" "}
                            {question.answer}
                        </Paragraph>
                    </FaqItem>
                ))
            }
        </FaqGrid>
    </Content>
</Section>
