---
import Section from "#/components/ui/Section.astro";
import Button from "#/components/ui/Button.astro";
import Highlight from "#/components/ui/Highlight.astro";
import Heading from "#/components/ui/Heading.astro";
---

<Section
    variant="gradient"
    headingId="heroHeading"
    descriptionId="heroDescription"
    classes="h-[80vh] justify-center md:h-[70vh] items-center"
>
    <div slot="text" class="z-2 flex w-full flex-col items-center gap-3">
        <Heading
            id="heroHeading"
            variant="h1"
            classes="mx-auto w-[80%] text-center text-4xl font-bold uppercase md:w-[50%] md:text-7xl"
        >
            personalized memes for <Highlight color="text-hot-fuchsia">your</Highlight> community
        </Heading>
        <p id="heroDescription" class="mx-auto my-5 w-[70%] text-center text-xl text-gray-300 md:w-[50%] md:text-3xl">
            Auto-generated memes from your conversations
        </p>
        <Button
            href="https://discord.com/oauth2/authorize?client_id=1375836467745783990"
            background="bg-discord-blue"
            textColor="text-white"
            icon="https://files.jstmemit.com/jstmemit/images/discord.svg"
            alt="discord logo"
            name="Add to your server"
            target="_blank"
            rel="noopener noreferrer"
        />
        <a
            href="#content"
            class="absolute hidden animate-bounce lg:bottom-[15%] 2xl:flex"
            tabindex="-1"
            aria-hidden="true"
        >
            <img alt="red chevron pointing down" src="https://files.jstmemit.com/jstmemit/images/icons/chevron.svg" />
        </a>
    </div>
</Section>
