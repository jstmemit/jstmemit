---
import List from "#/components/ui/List.astro";
import Paragraph from "#/components/ui/Paragraph.astro";
import Section from "#/components/ui/Section.astro";
import Heading from "#/components/ui/Heading.astro";
import Button from "#/components/ui/Button.astro";
import Card from "#/components/ui/Card.astro";
import Content from "#/components/ui/Content.astro";
import Highlight from "#/components/ui/Highlight.astro";

interface Props {
    classes?: string;
}

const { classes } = Astro.props;
---

<Section
    classes={classes}
    variant="dark"
    headingId="jstmemitsSourceCodeHeading"
    descriptionId="jstmemitsSourceCodeDescription"
>
    <Content slot="text" classes="items-center lg:flex-row lg:gap-10">
        <div class="flex flex-col gap-3 xl:w-[45%]">
            <Heading id="jstmemitsSourceCodeHeading">
                <Highlight color="text-bubblegum-pink">Jstmemit's</Highlight> source code is <Highlight
                    color="text-bubblegum-pink">public</Highlight
                >
            </Heading>
            <Paragraph id="jstmemitsSourceCodeDescription">
                If you are that kind of person, then feel welcome to deploy your own version of <b>Jstmemit</b>. Even
                better, it’s MIT licensed which means you can fork it, change it and do whatever you want with the
                result.
            </Paragraph>
            <Paragraph>
                However, if you just want to add the bot, then you can use our always online, free version of the bot.
                This way you do not need to host anything and can immediately start using <b>Jstmemit</b>.
            </Paragraph>

            <List classes="flex-col sm:flex-row ml-0 sm:ml-auto gap-5">
                <li class="flex flex-col gap-3">
                    <p class="text-base font-bold uppercase">Host your own:</p>
                    <Button
                        href="https://github.com/jstmemit/jstmemit"
                        background="bg-carbon-black"
                        textColor="text-white"
                        icon="https://files.jstmemit.com/jstmemit/images/icons/github.svg"
                        alt="github logo"
                        name="View source code"
                        target="_blank"
                        rel="noopener noreferrer"
                    />
                </li>
                <li class="flex flex-col gap-3">
                    <p class="text-base font-bold uppercase">Start using now:</p>
                    <Button
                        href="https://discord.com/oauth2/authorize?client_id=1375836467745783990"
                        background="bg-discord-blue"
                        textColor="text-white"
                        icon="https://files.jstmemit.com/jstmemit/images/discord.svg"
                        alt="discord logo"
                        name="Add to your server"
                        target="_blank"
                        rel="noopener noreferrer"
                    />
                </li>
            </List>
        </div>

        <div class="mt-5 ml-auto w-full truncate lg:mt-0 xl:w-1/2">
            <Card label="Terminal" background="bg-black" classes="mt-6 pt-5 relative p-4">
                <pre
                    class="min-h-auto font-mono text-xs font-normal text-white sm:w-auto sm:text-sm">
<Highlight color="text-hot-fuchsia" classes="font-medium"># Clone the project</Highlight>
git clone https://github.com/<br class="sm:hidden" />jstmemit/jstmemit.git

<Highlight color="text-hot-fuchsia" classes="font-medium"># Navigate into its directory</Highlight>
cd jstmemit

<Highlight color="text-hot-fuchsia" classes="font-medium"># Create a .env.docker file</Highlight>
nano .env.docker
                </pre>

                <div class="bg-carbon-black relative -mt-2 rounded-lg p-3">
                    <span class="absolute top-2 right-4 text-white/50 sm:top-3">.env.docker</span>
                    <pre
                        class="min-h-auto font-mono text-xs font-normal text-white sm:w-auto sm:text-sm">
<Highlight color="text-golden">DB_URL</Highlight><Highlight color="text-bubblegum-pink">=</Highlight>http://sqld:8080

<Highlight color="text-golden">DISCORD_TOKEN</Highlight><Highlight color="text-bubblegum-pink">=</Highlight> <Highlight color="text-white/50"># discord bot<br class="sm:hidden" /> token, you can get it <a target="_blank" rel="noopener noreferrer" href="https://discord.com/developers/home" class="text-bubblegum-pink">here</a></Highlight>
<Highlight color="text-golden">DISCORD_CLIENT_ID</Highlight><Highlight color="text-bubblegum-pink">=</Highlight> <Highlight color="text-white/50"># discord<br class="sm:hidden" /> application id</Highlight>

<Highlight color="text-golden">POSTHOG_READ_KEY</Highlight><Highlight color="text-bubblegum-pink">=</Highlight> <Highlight color="text-white/50"># analytics</Highlight>

<Highlight color="text-golden">REDIS_HOST</Highlight><Highlight color="text-bubblegum-pink">=</Highlight>redis
<Highlight color="text-golden">REDIS_PORT</Highlight><Highlight color="text-bubblegum-pink">=</Highlight>6379</pre>
                </div>

                <pre
                    class="relative mt-5 min-h-auto font-mono text-xs font-normal text-white sm:w-auto sm:text-sm">
<Highlight color="text-hot-fuchsia" classes="font-medium"># Build and launch docker compose</Highlight>
docker compose up --build</pre>
            </Card>
        </div>
    </Content>
</Section>
