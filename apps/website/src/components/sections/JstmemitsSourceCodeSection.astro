---
import List from "#/components/ui/List.astro";
import Paragraph from "#/components/ui/Paragraph.astro";
import Section from "#/components/ui/Section.astro";
import Heading from "#/components/ui/Heading.astro";
import Message from "#/components/ui/Message.astro";
import Separator from "#/components/ui/Separator.astro";
import Button from "#/components/ui/Button.astro";

interface Props {
    classes?: string;
}

const { classes } = Astro.props;
---

<Section
    classes={classes}
    variant="dark"
    headingId="jstmemitsSourceCodeHeading"
    descriptionId="jstmemitsSourceCodeDescription"
>
    <div slot="text" class="mx-auto flex w-full max-w-333 flex-col gap-3">
        <Heading id="jstmemitsSourceCodeHeading">
            <em class="text-bubblegum-pink not-italic">Jstmemit's</em> source code is <em
                class="text-bubblegum-pink not-italic">public</em
            >
        </Heading>
        <Paragraph id="jstmemitsSourceCodeDescription">
            If you are that kind of person, then feel welcome to deploy your own version of <b>Jstmemit</b>. Even
            better, it’s MIT licensed which means you can fork it, change it and do whatever you want with the result.
        </Paragraph>
        <Paragraph>
            However, if you just want to add the bot, then you can use our always online, free version of the bot. This
            way you do not need to host anything and can immediately start using <b>Jstmemit</b>.
        </Paragraph>

        <List classes="flex-col sm:flex-row ml-0 sm:ml-auto gap-5">
            <li class="flex flex-col gap-3">
                <p class="text-base font-bold uppercase">Host your own:</p>
                <Button
                    href="https://github.com/jstmemit/jstmemit"
                    background="bg-carbon-black"
                    textColor="text-white"
                    icon="https://files.jstmemit.com/jstmemit/images/icons/github.svg"
                    alt="github logo"
                    name="View source code"
                    target="_blank"
                    rel="noopener noreferrer"
                />
            </li>
            <li class="flex flex-col gap-3">
                <p class="text-base font-bold uppercase">Start using now:</p>
                <Button
                    href="https://discord.com/oauth2/authorize?client_id=1375836467745783990"
                    background="bg-discord-blue"
                    textColor="text-white"
                    icon="https://files.jstmemit.com/jstmemit/images/discord.svg"
                    alt="discord logo"
                    name="Add to your server"
                    target="_blank"
                    rel="noopener noreferrer"
                />
            </li>
        </List>
    </div>
</Section>
