---
import Button from "#/components/ui/Button.astro";
import Heading from "#/components/ui/Heading.astro";
import Paragraph from "#/components/ui/Paragraph.astro";
---

<section
    aria-labelledby="giveYourServerHumourHeading"
    aria-describedby="giveYourServerHumourDescription"
    class="bg-ash-black relative z-1 flex min-h-70 flex-col items-center justify-center gap-5 px-5 py-10 md:gap-3"
>
    <Heading id="giveYourServerHumourHeading" classes="text-white text-4xl text-center"
        >Give <span class="text-bubblegum-pink">your server</span> a sense of <span class="text-bubblegum-pink"
            >humour!</span
        ></Heading
    >
    <Paragraph id="giveYourServerHumourDescription" classes="text-center mb-3">
        Try it for yourself, it’s free, open-source and only works in channels you select
    </Paragraph>
    <Button
        href="https://discord.com/oauth2/authorize?client_id=1375836467745783990"
        background="bg-discord-blue"
        textColor="text-white"
        icon="https://files.jstmemit.com/jstmemit/images/discord.svg"
        alt="discord logo"
        name="Add to your server"
        target="_blank"
        rel="noopener noreferrer"
    />
    <img
        src="https://wideunits.nl/cdn-cgi/image/format=avif,fit=scale-down,metadata=none,sharpen=1,onerror=redirect,quality=50,slow-connection-quality=22,width=1900/https://files.jstmemit.com/jstmemit/images/background/Banner.png"
        loading="lazy"
        fetchpriority="low"
        class="absolute -z-1 h-full w-full object-cover"
        alt="Background with a blurred meme example and halftone dots"
        aria-hidden="true"
    />
</section>
