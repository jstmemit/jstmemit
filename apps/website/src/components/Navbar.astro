---
import Link from "./Link.astro";
import Button from "./Button.astro";
import type { NavbarLink } from "../models/NavbarLink.ts";

const links: NavbarLink[] = [
    {
        href: "/",
        name: "Features",
    },
    {
        href: "/",
        name: "How it works",
    },
    {
        href: "/",
        name: "Support",
    },
];
---

<nav
    class="bg-carbon-gray/30 border-carbon-light-gray relative mx-auto mt-12 flex max-w-333 items-center justify-between rounded-3xl border-2 px-6 py-5 text-white shadow-[0_10px_0_0_rgba(0,0,0,0.25)] backdrop-blur-lg"
>
    <img
        class="pointer-events-none mt-0.75 w-25 select-none"
        src="https://files.wideunits.nl/jstmemit/images/logos/logo%20text%20big.png"
        alt="logo with jstmemit text and underline"
    />
    <img
        class="pointer-events-none absolute -top-12 left-3 size-18 select-none"
        src="https://files.wideunits.nl/jstmemit/images/logos/emoji%20glow.png"
        alt="jstmemit logo"
    />
    <ul class="-mt-0.5 hidden gap-3 select-none md:flex">
        {links.map((link) => <Link href={link.href} name={link.name} />)}
    </ul>
    <Button
        href="https://discord.com/oauth2/authorize?client_id=1375836467745783990"
        background="bg-discord-blue"
        textColor="text-white"
        icon="https://files.wideunits.nl/jstmemit/images/discord.svg"
        alt="discord logo"
        name="Add to your server"
    />
</nav>
