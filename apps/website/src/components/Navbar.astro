---
import Link from "./Link.astro";
import Button from "./Button.astro";
import type { NavbarLink } from "../models/NavbarLink.ts";

const links: NavbarLink[] = [
    {
        href: "/",
        name: "Features",
    },
    {
        href: "/",
        name: "How it works",
    },
    {
        href: "/",
        name: "Support",
    }
]
---

<nav class="bg-carbon-gray/30 relative flex justify-between items-center rounded-3xl max-w-333 mx-auto py-5 px-6 mt-12 shadow-[0_10px_0_0_rgba(0,0,0,0.25)] border-carbon-light-gray border-2 text-white backdrop-blur-lg">
    <img class="w-25 mt-0.75" src="https://files.wideunits.nl/jstmemit/images/logos/logo%20text%20big.png" alt="logo with jstmemit text and underline" />
    <img class="absolute size-18 -top-12 left-3" src="https://files.wideunits.nl/jstmemit/images/logos/emoji%20glow.png" alt="jstmemit logo" />
    <ul class="hidden md:flex gap-3 -mt-0.5">
        {links.map(link => (
            <Link href={link.href} name={link.name} />
        ))}
    </ul>
    <Button
            href="https://discord.com/oauth2/authorize?client_id=1375836467745783990"
            background="bg-discord-blue"
            textColor="text-white"
            icon="https://files.wideunits.nl/jstmemit/images/discord.svg"
            alt="discord logo"
            name="Add to your server" />
</nav>
