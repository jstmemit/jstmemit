---
import type { BlurredMeme } from "#/models/BlurredMeme.ts";
interface Props {
    blurredMemes?: BlurredMeme[];
}

const {
    blurredMemes = [
        {
            class: "absolute top-10 z-1 right-50 w-75 md:w-125 pointer-events-none select-none",
            src: "https://wideunits.nl/cdn-cgi/image/format=avif,fit=scale-down,metadata=none,sharpen=1,onerror=redirect,quality=50,slow-connection-quality=30,width=auto/https://files.jstmemit.com/jstmemit/images/background/meme1.png",
            alt: "winnie pooh meme",
        },

        {
            class: "absolute bottom-20 z-1 left-50 w-75 md:w-125 pointer-events-none select-none",
            src: "https://wideunits.nl/cdn-cgi/image/format=avif,fit=scale-down,metadata=none,sharpen=1,onerror=redirect,quality=50,slow-connection-quality=30,width=auto/https://files.jstmemit.com/jstmemit/images/background/meme2.png",
            alt: "valorant meme",
        },

        {
            class: "absolute z-0 -right-10 -bottom-70 w-150 opacity-40 blur-md pointer-events-none select-none",
            src: "https://wideunits.nl/cdn-cgi/image/format=avif,fit=scale-down,metadata=none,sharpen=1,onerror=redirect,quality=50,slow-connection-quality=30,width=auto/https://files.jstmemit.com/jstmemit/images/background/meme1.png",
            alt: "winnie pooh meme",
        },

        {
            class: "absolute z-0 -top-35 -left-20 w-150 opacity-40 blur-md pointer-events-none select-none",
            src: "https://wideunits.nl/cdn-cgi/image/format=avif,fit=scale-down,metadata=none,sharpen=1,onerror=redirect,quality=50,slow-connection-quality=30,width=auto/https://files.jstmemit.com/jstmemit/images/background/meme2.png",
            alt: "valorant meme",
        },
    ],
} = Astro.props;
---

{
    blurredMemes.map((blurredMeme) => (
        <img
            fetchpriority="high"
            aria-hidden="true"
            loading="eager"
            class={blurredMeme.class}
            src={blurredMeme.src}
            alt={blurredMeme.alt}
        />
    ))
}
