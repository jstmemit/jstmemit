---
import type { BlurredMeme } from "../../models/BlurredMeme.ts";
interface Props {
    blurredMemes: BlurredMeme[];
}

const {
    blurredMemes = [
        {
            class: "absolute top-10 right-20 w-125",
            src: "https://files.wideunits.nl/jstmemit/images/background/meme1.png",
            alt: "winnie pooh meme",
        },

        {
            class: "absolute bottom-20 left-20 w-125",
            src: "https://files.wideunits.nl/jstmemit/images/background/meme2.png",
            alt: "valorant meme",
        },

        {
            class: "absolute -right-10 -bottom-70 w-150 opacity-40 blur-md",
            src: "https://files.wideunits.nl/jstmemit/images/background/meme1.png",
            alt: "winnie pooh meme",
        },

        {
            class: "absolute -top-35 -left-20 w-150 opacity-40 blur-md",
            src: "https://files.wideunits.nl/jstmemit/images/background/meme2.png",
            alt: "valorant meme",
        },
    ],
} = Astro.props;
---

{blurredMemes.map((blurredMeme) => <img class={blurredMeme.class} src={blurredMeme.src} alt={blurredMeme.alt} />)}
