---
interface Props {
    heading: string;
    color: string;
    classes?: string;
}

const { heading, color, classes } = Astro.props;
---

<li class={classes}>
    <p class="text-sm text-white/25 uppercase">{heading}</p>
    <p class="text-base">
        <em class=`${color} not-italic`>“</em><slot /><em class=`${color} not-italic`>“</em>
    </p>
</li>
