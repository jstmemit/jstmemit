---
interface Props {
    text: string;
    icon: string;
    alt: string;
    classes?: string;
}

const { text, icon, alt, classes } = Astro.props;
---

<li class=`flex items-center gap-3 whitespace-nowrap ${classes}`>
    <img class="size-6" src={icon} alt={alt} />
    <h3 class="mb-0.5 text-xl">{text}</h3>
</li>
