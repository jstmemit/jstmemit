---
import Separator from "#/components/ui/Separator.astro";
import type { MarqueeItem } from "#/models/MarqueeItem.ts";

interface Props {
    texts: MarqueeItem[];
    direction?: "left" | "right";
    variant?: "bg" | "hero";
}

const { texts, direction = "right", variant = "bg" } = Astro.props;
texts.push(...texts);
---

{
    variant === "bg" && (
        <div class="relative">
            <ul
                class={`${direction === "right" ? "animate-marquee-right" : "animate-marquee-left"} absolute top-0 flex items-center gap-2.5 text-xs text-white/30`}
            >
                {texts.map((item: MarqueeItem, index: number) => (
                    <li class="flex items-center gap-2.5 whitespace-nowrap">
                        {item.text}

                        {index !== texts.length - 1 && <Separator />}
                    </li>
                ))}
            </ul>
            <ul
                class={`${direction === "right" ? "animate-marquee-right2" : "animate-marquee-left2"} flex items-center gap-2.5 text-xs text-white/30`}
            >
                {texts.map((item: MarqueeItem, index: number) => (
                    <li class="flex items-center gap-2.5 whitespace-nowrap">
                        {item.text}

                        {index !== texts.length - 1 && <Separator />}
                    </li>
                ))}
            </ul>
        </div>
    )
}

{
    variant === "hero" && (
        <div class="relative z-1 flex bg-black/50 py-6 backdrop-blur-md md:w-screen">
            <div class="absolute top-0 left-0 z-2 h-full w-18 bg-linear-to-r from-black to-transparent" />
            <div class="absolute top-0 right-0 z-2 h-full w-18 bg-linear-to-l from-black to-transparent" />

            <ul
                class={`${direction === "right" ? "animate-marquee-right" : "animate-marquee-left"} absolute top-2 flex items-center gap-15 font-bold text-white uppercase italic md:text-2xl`}
            >
                {texts.map((item: MarqueeItem, index: number) => (
                    <li class="flex items-center gap-2.5 whitespace-nowrap">
                        <img src={item.icon} alt={item.alt} />

                        {item.text}
                    </li>
                ))}
            </ul>
            <ul
                class={`${direction === "right" ? "animate-marquee-right2" : "animate-marquee-left2"} absolute top-2 left-12 flex items-center gap-15 font-bold text-white uppercase italic md:text-2xl`}
            >
                {texts.map((item: MarqueeItem, index: number) => (
                    <li class="flex items-center gap-2.5 whitespace-nowrap">
                        <img src={item.icon} alt={item.alt} />

                        {item.text}
                    </li>
                ))}
            </ul>
        </div>
    )
}
