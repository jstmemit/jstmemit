---
import Separator from "#/components/ui/Separator.astro";
import type { MarqueeItem } from "#/models/MarqueeItem.ts";

interface Props {
    texts: MarqueeItem[];
    direction?: "left" | "right";
    variant?: "bg" | "hero";
}

const { texts, direction = "right", variant = "bg" } = Astro.props;
texts.push(...texts);
---

{
    variant === "bg" && (
        <div class="relative">
            <ul
                class={`${direction === "right" ? "animate-marquee-right" : "animate-marquee-left"} absolute top-0 flex items-center gap-2.5 text-xs text-white/30`}
            >
                {texts.map((item: MarqueeItem, index: number) => (
                    <li class="flex items-center gap-2.5 whitespace-nowrap">
                        {item.text}

                        {index !== texts.length - 1 && <Separator />}
                    </li>
                ))}
            </ul>
            <ul
                class={`${direction === "right" ? "animate-marquee-right2" : "animate-marquee-left2"} flex items-center gap-2.5 text-xs text-white/30`}
            >
                {texts.map((item: MarqueeItem, index: number) => (
                    <li class="flex items-center gap-2.5 whitespace-nowrap">
                        {item.text}

                        {index !== texts.length - 1 && <Separator />}
                    </li>
                ))}
            </ul>
        </div>
    )
}
