---
import BlurredMemes from "#/components/background/decorations/BlurredMemes.astro";
import GradientBackground from "#/components/background/variants/GradientBackground.astro";

interface Props {
    variant: "light" | "dark" | "gradient";
    classes?: string;
}

const { variant, classes } = Astro.props;
---

<section
    class=`${classes} relative flex flex-col gap-5 px-8 overflow-hidden ${variant === "gradient" && "bg-black"} ${variant === "light" && "bg-ash-black"} ${variant === "light" && "bg-ash-black"} ${variant === "dark" && "bg-void-black"} text-white py-20`
>
    <slot name="text" />

    {
        variant === "gradient" && (
            <GradientBackground>
                <BlurredMemes slot="decorations" />
            </GradientBackground>
        )
    }
</section>
