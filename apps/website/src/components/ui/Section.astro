---
import BlurredMemes from "#/components/background/decorations/BlurredMemes.astro";
import GradientBackground from "#/components/background/variants/GradientBackground.astro";

interface Props {
    variant: "light" | "dark" | "gradient";
    classes?: string;
}

const { variant, classes } = Astro.props;
---

<section
    class=`${classes} relative flex flex-col gap-5 px-8 overflow-hidden ${variant === "gradient" && "bg-black"} ${variant === "light" && "bg-ash-black"} ${variant === "light" && "bg-ash-black"} ${variant === "dark" && "bg-void-black"} text-white py-20`
>
    <slot name="text" />

    {
        variant !== "gradient" && (
            <img
                class="pointer-events-none absolute top-0 left-0 z-1 h-full w-full object-cover opacity-6 select-none"
                src="https://wideunits.nl/cdn-cgi/image/format=avif,fit=scale-down,metadata=none,sharpen=1,onerror=redirect,quality=40,slow-connection-quality=22,width=1600/https://files.wideunits.nl/jstmemit/images/background/Noise.png"
                alt="background noise"
            />
        )
    }

    {
        variant === "gradient" && (
            <GradientBackground>
                <BlurredMemes slot="decorations" />
            </GradientBackground>
        )
    }
</section>
