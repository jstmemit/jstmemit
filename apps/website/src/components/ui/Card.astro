---
interface Props {
    label: string;
    color?: string;
    border?: string;
    classes?: string;
}

const { label, classes, color = "bg-bubblegum-pink", border = "border-bubblegum-pink border-4" } = Astro.props;
---

<div
    class=`bg-carbon-black w-full text-white relative rounded-2xl rounded-t-none shadow-(--shadow-10) ${classes} ${border}`
>
    <span
        class=`${color} absolute -top-7 -right-1 -left-1 rounded-xl rounded-b-none p-1 px-2 text-lg uppercase truncate font-extrabold`
    >
        {label}
    </span>
    <slot />
</div>
