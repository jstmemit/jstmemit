---
const { label, classes } = Astro.props;
---

<div class=`bg-carbon-black w-full max-w-fit relative rounded-2xl rounded-t-none p-4 pt-5 ${classes}`>
    <span
        class="bg-bubblegum-pink absolute -top-7 right-0 left-0 rounded-xl rounded-b-none p-1 px-2 text-lg font-extrabold"
    >
        {label}
    </span>
    <slot />
</div>
