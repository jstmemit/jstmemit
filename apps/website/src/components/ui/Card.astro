---
interface Props {
    label: string;
    color?: string;
    classes?: string;
}

const { label, classes, color = "bg-bubblegum-pink" } = Astro.props;
---

<div class=`bg-carbon-black w-full text-white relative rounded-2xl rounded-t-none ${classes}`>
    <span
        class=`${color} absolute -top-7 right-0 left-0 rounded-xl rounded-b-none p-1 px-2 text-lg uppercase truncate font-extrabold`
    >
        {label}
    </span>
    <slot />
</div>
