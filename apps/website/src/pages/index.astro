---
import PageLayout from "#/layout/PageLayout.astro";
import HowExactlyDoesThatWorkSection from "#/components/sections/HowExactlyDoesThatWorkSection.astro";
import ChatAndJstmemitWillMakeMemesSection from "#/components/sections/ChatAndJstmemitWillMakeMemesSection.astro";
import HeroSection from "#/components/sections/HeroSection.astro";
import FeatureMarqueeSection from "#/components/sections/FeatureMarqueeSection.astro";
import MemeGrid from "#/components/MemeGrid.astro";
import BannerSection from "#/components/sections/BannerSection.astro";
import ButWhatAboutPrivacySection from "#/components/sections/ButWhatAboutPrivacySection.astro";
import Anchor from "#/components/ui/Anchor.astro";
import JstmemitsSourceCodeSection from "#/components/sections/JstmemitsSourceCodeSection.astro";
import FaqSection from "#/components/sections/FaqSection.astro";
import OkayButShowMeSomeMemesSection from "#/components/sections/OkayButShowMeSomeMemesSection.astro";
import AddJstmemitWontRegretSection from "#/components/sections/AddJstmemitWontRegretSection.astro";
---

<PageLayout
    title="Jstmemit // Discord bot that makes memes about your server"
    canonical="https://jstmemit.com"
    isMain={true}
>
    <HeroSection />
    <FeatureMarqueeSection />

    <div class="relative flex flex-col overflow-hidden">
        <Anchor id="content" classes="-top-50" />

        <ChatAndJstmemitWillMakeMemesSection />
        <HowExactlyDoesThatWorkSection classes="order-1 xl:order-0" />
        <MemeGrid classes="order-0" />
    </div>

    <BannerSection />
    <ButWhatAboutPrivacySection />
    <JstmemitsSourceCodeSection />
    <OkayButShowMeSomeMemesSection />
    <FaqSection />
    <AddJstmemitWontRegretSection />
</PageLayout>
