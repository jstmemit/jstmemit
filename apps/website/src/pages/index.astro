---

import PageLayout from "../layout/PageLayout.astro";

---

<PageLayout>
    <section class="bg-black text-white h-[80vh] flex flex-col gap-5 justify-center items-center">
        <h1 class="font-bold uppercase text-4xl md:text-7xl w-[80%] md:w-[50%] text-center mx-auto">
            personalized memes for <span class="text-hot-fuchsia">your</span> community
        </h1>
        <p class="text-white/60 text-xl md:text-3xl w-[70%] md:w-[50%] text-center mx-auto">
            Auto-generated memes from your conversations
        </p>
    </section>
</PageLayout>